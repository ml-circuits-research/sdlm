# Elementary knowledge expressed with ordinary SOP atom and rule constructors.
@n1 makeConstant
    value "eye"
@n2 makeConstant
    value "see"
@n3 makeBinaryAtom
    subject $n1
    predicate "purpose"
    polarity "positive"
    object $n2
@n4 kbAssertFact
    atom $n3
