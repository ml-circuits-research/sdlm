@input tokens
@input index
@classes list
    item0 "noun"
@suffix record
    suffix "s"
    replacement ""
    minStem 3
@transforms list
    item1 $suffix
@result interpretSymbol
    tokens $tokens
    index $index
    classes $classes
    category "category-inference"
    reason "Used this word as a unary class because it occupies the quantified subject position. An unknown final s is treated as a plural suffix."
    transforms $transforms
@output result $result
