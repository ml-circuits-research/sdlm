@input tokens
@size tokenCountIs
    tokens $tokens
    count 4
@guard0 tokenIs
    tokens $tokens
    index 0
    value "do"
@guard3 tokenIs
    tokens $tokens
    index 3
    value "?"
@subject InterpretEntity
    tokens $tokens
    index 1
@verb InterpretVerb
    tokens $tokens
    index 2
@predicate field
    value $verb
    name "value"
@atom makeUnaryAtom
    subject $subject
    predicate $predicate
@command makeCommand
    kind "askBoolean"
    payload $atom
@lexical collectDecisions
    verb $verb
@decisions constant
    value $lexical
@result record
    command $command
    decisions $decisions
@output result $result
