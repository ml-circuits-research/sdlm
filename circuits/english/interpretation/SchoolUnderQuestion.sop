@input tokens
@count tokenCountIs
    tokens $tokens
    count 5
@g0 tokenIs
    tokens $tokens
    index 0
    value "is"
@g2 tokenIs
    tokens $tokens
    index 2
    value "under"
@g4 tokenIs
    tokens $tokens
    index 4
    value "?"
@subject constantAt
    tokens $tokens
    index 1
@object constantAt
    tokens $tokens
    index 3
@payload makeBinaryAtom
    subject $subject
