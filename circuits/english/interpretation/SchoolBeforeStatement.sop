@input tokens
@count tokenCountIs
    tokens $tokens
    count 5
@g1 tokenIs
    tokens $tokens
    index 1
    value "is"
@g2 tokenIs
    tokens $tokens
    index 2
    value "before"
@g4 tokenIs
    tokens $tokens
    index 4
    value "."
@subject constantAt
    tokens $tokens
    index 0
@object constantAt
    tokens $tokens
    index 3
@payload makeBinaryAtom
    subject $subject
    predicate "before"
    object $object
@command makeCommand
    kind "assertFact"
    payload $payload
@decisions list
@result record
    command $command
    decisions $decisions
@output result $result
