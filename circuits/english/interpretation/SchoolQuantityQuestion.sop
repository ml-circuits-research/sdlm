@input tokens
@count tokenCountIs
    tokens $tokens
    count 7
@g0 tokenIs
    tokens $tokens
    index 0
    value "how"
@g1 tokenIs
    tokens $tokens
    index 1
    value "many"
@g3 tokenIs
    tokens $tokens
    index 3
    value "does"
@g5 tokenIs
    tokens $tokens
    index 5
    value "have"
@g6 tokenIs
    tokens $tokens
    index 6
    value "?"
@subject constantAt
    tokens $tokens
    index 4
@noun InterpretNoun
    tokens $tokens
    index 2
@lemma field
    value $noun
    name "value"
@predicate concat
    part1 "count_"
    part2 $lemma
@payload record
    subject $subject
    predicate $predicate
    numeric true
@decisions collectDecisions
    noun $noun
@command makeCommand
    kind "readValue"
    payload $payload
@result record
    command $command
    decisions $decisions
@output result $result
