@input tokens
@count tokenCountIs
    tokens $tokens
    count 4
@g0 tokenIs
    tokens $tokens
    index 0
    value "can"
@g3 tokenIs
    tokens $tokens
    index 3
    value "?"
@subject constantAt
    tokens $tokens
    index 1
@verb InterpretVerb
    tokens $tokens
    index 2
@predicate field
    value $verb
    name "value"
@payload makeUnaryAtom
    subject $subject
    predicate $predicate
    qualifier "can"
@decisions collectDecisions
    verb $verb
@command makeCommand
    kind "askBoolean"
    payload $payload
@result record
    command $command
    decisions $decisions
@output result $result
