@input tokens
@count tokenCountIs
    tokens $tokens
    count 6
@g0 tokenIs
    tokens $tokens
    index 0
    value "is"
@g2 tokenIs
    tokens $tokens
    index 2
    value "greater"
@g3 tokenIs
    tokens $tokens
    index 3
    value "than"
@g5 tokenIs
    tokens $tokens
    index 5
    value "?"
@left numericToken
    tokens $tokens
    index 1
@right numericToken
    tokens $tokens
    index 4
@payload record
    left $left
    right $right
    operation "greater"
@command makeCommand
    kind "compareNumbers"
    payload $payload
@decisions list
@result record
    command $command
    decisions $decisions
@output result $result
