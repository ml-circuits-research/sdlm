@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 4
@n2 tokenIs
    tokens $tokens
    index 0
    value "keep"
@n3 tokenIs
    tokens $tokens
    index 1
    value "answers"
@n4 tokenIs
    tokens $tokens
    index 2
    value "short"
@n5 tokenIs
    tokens $tokens
    index 3
    value "."
@n6 makeCommand
    kind "responseStyle"
    payload "answer"
@n7 list
@n8 record
    command $n6
    decisions $n7
@output result $n8
