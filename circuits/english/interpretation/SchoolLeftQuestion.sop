@input tokens
@count tokenCountIs
    tokens $tokens
    count 6
@g0 tokenIs
    tokens $tokens
    index 0
    value "is"
@g2 tokenIs
    tokens $tokens
    index 2
    value "left"
@g3 tokenIs
    tokens $tokens
    index 3
    value "of"
@g5 tokenIs
    tokens $tokens
    index 5
    value "?"
@subject constantAt
    tokens $tokens
    index 1
@object constantAt
    tokens $tokens
    index 4
@payload makeBinaryAtom
    subject $subject
    predicate "left"
