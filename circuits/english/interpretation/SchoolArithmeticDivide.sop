@input tokens
@count tokenCountIs
    tokens $tokens
    count 7
@g0 tokenIs
    tokens $tokens
    index 0
    value "what"
@g1 tokenIs
    tokens $tokens
    index 1
    value "is"
@g3 tokenIs
    tokens $tokens
    index 3
    value "divided"
@g4 tokenIs
    tokens $tokens
    index 4
    value "by"
@g6 tokenIs
    tokens $tokens
    index 6
    value "?"
@left numericToken
    tokens $tokens
    index 2
@right numericToken
    tokens $tokens
    index 5
@payload record
    left $left
    right $right
    operation "divide"
@command makeCommand
    kind "calculateNumber"
    payload $payload
@decisions list
@result record
    command $command
    decisions $decisions
@output result $result
