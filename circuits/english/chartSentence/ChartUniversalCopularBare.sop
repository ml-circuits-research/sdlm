@input tree
@g parseProductionIs
    value $tree
    production "UniversalCopularBare"
@classTree chartChild
    tree $tree
    index 1
@propTree chartChild
    tree $tree
    index 3
@class chartNorm
    tree $classTree
@prop chartNorm
    tree $propTree
@x makeVariable
    name "X"
@bodyAtom makeUnaryAtom
    subject $x
    predicate $class
    polarity "positive"
@headAtom makeUnaryAtom
    subject $x
    predicate $prop
    polarity "positive"
@body list
    item1 $bodyAtom
@rule makeRule
    head $headAtom
    body $body
@command makeCommand
    kind "assertRule"
    payload $rule
@output result $command
