@input tree
@g parseProductionIs
    value $tree
    production "AskV5Very"
@sTree chartChild
    tree $tree
    index 1
@pTree chartChild
    tree $tree
    index 3
@s chartTerm
    tree $sTree
@p chartNorm
    tree $pTree
@pred concat
    a "very_"
    b $p
@atom makeUnaryAtom
    subject $s
    predicate $pred
    polarity "positive"
@command makeCommand
    kind "askBoolean"
    payload $atom
@output result $command
