@input tree
@g valueFieldIs
    value $tree
    name "production"
    expected "EveryArticle"
@subNode chartChild
    tree $tree
    index 1
@supNode chartChild
    tree $tree
    index 4
@sub chartNorm
    tree $subNode
@sup chartNorm
    tree $supNode
@x makeVariable
    name "X"
@bodyAtom makeUnaryAtom
    subject $x
    predicate $sub
    polarity "positive"
@headAtom makeUnaryAtom
    subject $x
    predicate $sup
    polarity "positive"
@body list
    item1 $bodyAtom
@rule makeRule
    head $headAtom
    body $body
@command makeCommand
    kind "assertRule"
    payload $rule
@output result $command
