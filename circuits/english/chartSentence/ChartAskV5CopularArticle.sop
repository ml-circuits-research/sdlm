@input tree
@g parseProductionIs
    value $tree
    production "AskV5CopularArticle"
@sTree chartChild
    tree $tree
    index 1
@pTree chartChild
    tree $tree
    index 3
@s chartTerm
    tree $sTree
@p chartNorm
    tree $pTree
@atom makeUnaryAtom
    subject $s
    predicate $p
    polarity "positive"
@command makeCommand
    kind "askBoolean"
    payload $atom
@output result $command
