@input atom
@g1 atomArityIs
    value $atom
    arity 1
@g2 atomPolarityIs
    value $atom
    polarity "positive"
@g3 predicateHasLexemeClass
    atom $atom
    class "verbBase"
@bias candidateWeight
    weight 30
@subject atomArgument
    atom $atom
    index 0
@subjectText display
    value $subject
@predicate atomPredicate
    atom $atom
@verb lexemeSurface
    lemma $predicate
    class "verb3"
@text concat
    part1 $subjectText
    part2 " "
    part3 $verb
    part4 "."
@output result $text
