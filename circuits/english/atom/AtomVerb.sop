@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 3
@g2 tokenClassIs
    tokens $tokens
    index 1
    class "verb3"
@subject termAt
    tokens $tokens
    index 0
    variableClass "variable"
@predicate tokenLemmaAt
    tokens $tokens
    index 1
    class "verb3"
@object termAt
    tokens $tokens
    index 2
    variableClass "variable"
@atom makeBinaryAtom
    subject $subject
    predicate $predicate
    object $object
    polarity "positive"
@output result $atom
