@input answer
@g1 answerKindIs
    value $answer
    kind "entityProfile"
@g2 answerStatusIs
    value $answer
    status "true"
@g3 valueFieldIs
    value $answer
    name "mode"
    expected "expansion"
@entity field
    value $answer
    name "entity"
@displayName display
    value $entity
@items field
    value $answer
    name "items"
@ranked sortByNumber
    values $items
    field "depth"
    direction "asc"
@rankedAtoms arrayField
    values $ranked
    name "atom"
@selected take
    values $rankedAtoms
    count 10
@sentences realizeAtoms
    atoms $selected
@joined join
    values $sentences
    separator " "
@direct field
    value $answer
    name "directCount"
@derived field
    value $answer
    name "derivedCount"
@text concat
    part1 "A fuller expansion of "
    part2 $displayName
    part3 ": "
    part4 $joined
    part5 " This view uses "
    part6 $direct
    part7 " directly stated facts and "
    part8 $derived
    part9 " derived facts."
@output result $text
