@input answer
@g1 answerKindIs
    value $answer
    kind "exists"
@g2 answerStatusIs
    value $answer
    status "true"
@values field
    value $answer
    name "values"
@joined join
    values $values
    separator ", "
@text concat
    part1 "Yes. At least one matching entity is derivable: "
    part2 $joined
    part3 "."
@output result $text
