@input answer
@g1 answerKindIs
    value $answer
    kind "missing"
@g2 answerStatusIs
    value $answer
    status "true"
@missing field
    value $answer
    name "missing"
@known field
    value $answer
    name "known"
@missingSentences realizeAtoms
    atoms $missing
@knownSentences realizeAtoms
    atoms $known
@missingText joinOrDefault
    values $missingSentences
    separator " "
    fallback "none"
@knownText joinOrDefault
    values $knownSentences
    separator " "
    fallback "none"
@text concat
    part1 "A currently closest derivation path is missing: "
    part2 $missingText
    part3 " Already available on that path: "
    part4 $knownText
@output result $text
