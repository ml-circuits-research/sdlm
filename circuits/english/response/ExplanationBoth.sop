@input answer
@g1 answerKindIs
    value $answer
    kind "explanation"
@g2 answerStatusIs
    value $answer
    status "both"
@support field
    value $answer
    name "support"
@refutation field
    value $answer
    name "refutation"
@supportLines proofLines
    tree $support
@refutationLines proofLines
    tree $refutation
@s join
    values $supportLines
    separator "\n"
@r join
    values $refutationLines
    separator "\n"
@text concat
    part1 "Support:\n"
    part2 $s
    part3 "\nRefutation:\n"
    part4 $r
@output result $text
