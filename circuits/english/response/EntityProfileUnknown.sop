@input answer
@g1 answerKindIs
    value $answer
    kind "entityProfile"
@g2 answerStatusIs
    value $answer
    status "unknown"
@entity field
    value $answer
    name "entity"
@displayName display
    value $entity
@text concat
    part1 "I do not currently have enough knowledge to describe "
    part2 $displayName
    part3 "."
@output result $text
