@input answer
@g1 answerKindIs
    value $answer
    kind "reflection"
@g2 answerStatusIs
    value $answer
    status "false"
@tree field
    value $answer
    name "refutation"
@lines proofLines
    tree $tree
@proof join
    values $lines
    separator "\n"
@depth field
    value $answer
    name "refutationDepth"
@rules field
    value $answer
    name "relevantRuleCount"
@text concat
    part1 "I can derive the explicit opposite of the claim. The refutation depth is "
    part2 $depth
    part3 ". I found "
    part4 $rules
    part5 " potentially relevant rule paths. Symbolic refutation:\n"
    part6 $proof
@output result $text
