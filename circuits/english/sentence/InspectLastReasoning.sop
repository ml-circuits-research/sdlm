@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 5
@g2 tokenIs
    tokens $tokens
    index 0
    value "inspect"
@g3 tokenIs
    tokens $tokens
    index 1
    value "your"
@g4 tokenIs
    tokens $tokens
    index 2
    value "last"
@g5 tokenIs
    tokens $tokens
    index 3
    value "reasoning"
@g6 tokenLastIs
    tokens $tokens
    value "."
@payload constant
    value true
@command makeCommand
    kind "introspect"
    payload $payload
@output result $command
