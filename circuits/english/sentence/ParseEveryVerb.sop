@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 5
@g2 tokenIs
    tokens $tokens
    index 0
    value "every"
@g3 tokenClassIs
    tokens $tokens
    index 2
    class "verb3"
@g4 tokenLastIs
    tokens $tokens
    value "."
@x makeVariable
    name "X"
@sourcePred tokenNormAt
    tokens $tokens
    index 1
@verbPred tokenLemmaAt
    tokens $tokens
    index 2
    class "verb3"
@object constantAt
    tokens $tokens
    index 3
@source makeUnaryAtom
    subject $x
    predicate $sourcePred
    polarity "positive"
@target makeBinaryAtom
    subject $x
    predicate $verbPred
    object $object
    polarity "positive"
@body list
    item1 $source
@rule makeRule
    head $target
    body $body
@command makeCommand
    kind "assertRule"
    payload $rule
@output result $command
