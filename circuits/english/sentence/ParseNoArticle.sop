@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 6
@g2 tokenIs
    tokens $tokens
    index 0
    value "no"
@g3 tokenIs
    tokens $tokens
    index 2
    value "is"
@g4 tokenClassIs
    tokens $tokens
    index 3
    class "article"
@g5 tokenLastIs
    tokens $tokens
    value "."
@x makeVariable
    name "X"
@sourcePred tokenNormAt
    tokens $tokens
    index 1
@targetPred tokenNormAt
    tokens $tokens
    index 4
@source makeUnaryAtom
    subject $x
    predicate $sourcePred
    polarity "positive"
@target makeUnaryAtom
    subject $x
    predicate $targetPred
    polarity "negative"
@body list
    item1 $source
@rule makeRule
    head $target
    body $body
@command makeCommand
    kind "assertRule"
    payload $rule
@output result $command
