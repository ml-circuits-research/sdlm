@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 8
@g2 tokenIs
    tokens $tokens
    index 0
    value "why"
@g3 tokenIs
    tokens $tokens
    index 1
    value "is"
@g4 tokenClassIs
    tokens $tokens
    index 2
    class "entity"
@g5 tokenClassIs
    tokens $tokens
    index 3
    class "article"
@g6 tokenClassIs
    tokens $tokens
    index 4
    class "relationNoun"
@g7 tokenIs
    tokens $tokens
    index 5
    value "of"
@g8 tokenClassIs
    tokens $tokens
    index 6
    class "entity"
@g9 tokenLastIs
    tokens $tokens
    value "?"
@subject constantAt
    tokens $tokens
    index 2
@predicate tokenLemmaAt
    tokens $tokens
    index 4
    class "relationNoun"
@object constantAt
    tokens $tokens
    index 6
@atom makeBinaryAtom
    subject $subject
    predicate $predicate
    object $object
    polarity "positive"
@command makeCommand
    kind "explain"
    payload $atom
@output result $command
