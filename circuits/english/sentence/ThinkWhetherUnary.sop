@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 7
@g2 tokenIs
    tokens $tokens
    index 0
    value "think"
@g3 tokenIs
    tokens $tokens
    index 1
    value "about"
@g4 tokenIs
    tokens $tokens
    index 2
    value "whether"
@g5 tokenIs
    tokens $tokens
    index 4
    value "is"
@g6 tokenLastIs
    tokens $tokens
    value "."
@subject constantAt
    tokens $tokens
    index 3
@predicate tokenNormAt
    tokens $tokens
    index 5
@atom makeUnaryAtom
    subject $subject
    predicate $predicate
    polarity "positive"
@command makeCommand
    kind "reflect"
    payload $atom
@output result $command
