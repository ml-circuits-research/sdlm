@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 5
@g2 tokenIs
    tokens $tokens
    index 0
    value "why"
@g3 tokenIs
    tokens $tokens
    index 1
    value "is"
@g4 tokenClassIs
    tokens $tokens
    index 2
    class "entity"
@g5 tokenLastIs
    tokens $tokens
    value "?"
@subject constantAt
    tokens $tokens
    index 2
@predicate tokenNormAt
    tokens $tokens
    index 3
@atom makeUnaryAtom
    subject $subject
    predicate $predicate
    polarity "positive"
@command makeCommand
    kind "explain"
    payload $atom
@output result $command
