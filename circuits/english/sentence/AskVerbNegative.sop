@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 6
@g2 tokenIs
    tokens $tokens
    index 0
    value "does"
@g3 tokenClassIs
    tokens $tokens
    index 1
    class "entity"
@g4 tokenIs
    tokens $tokens
    index 2
    value "not"
@g5 tokenClassIs
    tokens $tokens
    index 3
    class "verbBase"
@g6 tokenClassIs
    tokens $tokens
    index 4
    class "entity"
@g7 tokenLastIs
    tokens $tokens
    value "?"
@subject constantAt
    tokens $tokens
    index 1
@predicate tokenLemmaAt
    tokens $tokens
    index 3
    class "verbBase"
@object constantAt
    tokens $tokens
    index 4
@atom makeBinaryAtom
    subject $subject
    predicate $predicate
    object $object
    polarity "negative"
@command makeCommand
    kind "askBoolean"
    payload $atom
@output result $command
