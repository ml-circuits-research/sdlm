@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 6
@g2 tokenIs
    tokens $tokens
    index 0
    value "what"
@g3 tokenIs
    tokens $tokens
    index 1
    value "would"
@g4 tokenIs
    tokens $tokens
    index 2
    value "make"
@g5 tokenClassIs
    tokens $tokens
    index 3
    class "entity"
@g6 tokenLastIs
    tokens $tokens
    value "?"
@subject constantAt
    tokens $tokens
    index 3
@predicate tokenNormAt
    tokens $tokens
    index 4
@atom makeUnaryAtom
    subject $subject
    predicate $predicate
    polarity "positive"
@command makeCommand
    kind "missing"
    payload $atom
@output result $command
