@input tokens
@g1 tokenCountIs
    tokens $tokens
    count 3
@g2 tokenIs
    tokens $tokens
    index 0
    value "expand"
@g3 tokenClassIs
    tokens $tokens
    index 1
    class "entity"
@g4 tokenLastIs
    tokens $tokens
    value "."
@entity constantAt
    tokens $tokens
    index 1
@command makeCommand
    kind "expandEntity"
    payload $entity
@output result $command
