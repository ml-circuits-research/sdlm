@rhs10sym3 grammarToken
    value "more"
@rhs10sym4 grammarCategory
    name "word"
@rhs10sym5 grammarToken
    value "than"
@rhs10sym6 grammarCategory
    name "Term"
@rhs10sym7 grammarToken
    value "?"
@rhs10 list
    item1 $rhs10sym1
    item2 $rhs10sym2
    item3 $rhs10sym3
    item4 $rhs10sym4
    item5 $rhs10sym5
    item6 $rhs10sym6
    item7 $rhs10sym7
@r10 addGrammarRule
    name "AskV5Comparative"
    lhs "Sentence"
    rhs $rhs10
    weight 7
@rhs11sym1 grammarCategory
    name "Copula"
@rhs11sym2 grammarCategory
    name "Term"
@rhs11sym3 grammarToken
    value "very"
@rhs11sym4 grammarCategory
    name "word"
@rhs11sym5 grammarToken
    value "?"
@rhs11 list
    item1 $rhs11sym1
    item2 $rhs11sym2
    item3 $rhs11sym3
    item4 $rhs11sym4
    item5 $rhs11sym5
@r11 addGrammarRule
    name "AskV5Very"
    lhs "Sentence"
    rhs $rhs11
    weight 7
@rhs12sym1 grammarToken
    value "has"
@rhs12sym2 grammarCategory
    name "Term"
@rhs12sym3 grammarCategory
    name "verbPart"
@rhs12sym4 grammarCategory
    name "Term"
@rhs12sym5 grammarToken
