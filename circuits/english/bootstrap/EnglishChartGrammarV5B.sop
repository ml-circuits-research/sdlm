@rhs3 list
    item1 $rhs3sym1
    item2 $rhs3sym2
    item3 $rhs3sym3
@r3 addGrammarRule
    name "AtomV5NegCopulaContraction"
    lhs "Atom"
    rhs $rhs3
    weight 5
@rhs4sym1 grammarCategory
    name "Term"
@rhs4sym2 grammarCategory
    name "negAuxDo"
@rhs4sym3 grammarCategory
    name "verbBase"
@rhs4sym4 grammarCategory
    name "Term"
@rhs4 list
    item1 $rhs4sym1
    item2 $rhs4sym2
    item3 $rhs4sym3
    item4 $rhs4sym4
@r4 addGrammarRule
    name "AtomV5NegVerbContraction"
    lhs "Atom"
    rhs $rhs4
    weight 5
@rhs5sym1 grammarCategory
    name "Term"
@rhs5sym2 grammarCategory
    name "negModal"
@rhs5sym3 grammarCategory
