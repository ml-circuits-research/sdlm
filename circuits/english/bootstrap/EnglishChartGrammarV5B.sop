    item3 $rhs2sym3
    item4 $rhs2sym4
@r2 addGrammarRule
    name "AtomV5PastPerfect"
    lhs "Atom"
    rhs $rhs2
    weight 5
@rhs3sym1 grammarCategory
    name "Term"
@rhs3sym2 grammarCategory
