@rhs5sym4 grammarCategory
    name "Term"
@rhs5 list
    item1 $rhs5sym1
    item2 $rhs5sym2
    item3 $rhs5sym3
    item4 $rhs5sym4
@r5 addGrammarRule
    name "AtomV5NegModalContraction"
    lhs "Atom"
    rhs $rhs5
    weight 5
@rhs6sym1 grammarCategory
    name "UniversalQuant"
@rhs6sym2 grammarCategory
    name "noun"
@rhs6sym3 grammarCategory
    name "Copula"
@rhs6sym4 grammarCategory
    name "word"
@rhs6sym5 grammarToken
    value "."
@rhs6 list
    item1 $rhs6sym1
    item2 $rhs6sym2
    item3 $rhs6sym3
    item4 $rhs6sym4
    item5 $rhs6sym5
@r6 addGrammarRule
    name "UniversalNounCopular"
    lhs "Sentence"
    rhs $rhs6
    weight 9
@rhs7sym1 grammarCategory
    name "NoQuant"
@rhs7sym2 grammarCategory
    name "noun"
@rhs7sym3 grammarCategory
    name "Copula"
@rhs7sym4 grammarCategory
    name "word"
@rhs7sym5 grammarToken
