    item2 $rhs13sym2
    item3 $rhs13sym3
    item4 $rhs13sym4
    item5 $rhs13sym5
@r13 addGrammarRule
    name "AskV5Progressive"
    lhs "Sentence"
    rhs $rhs13
    weight 7
@output result $r13
