# Additional common English forms for V5.
@rhs0sym1 grammarCategory
    name "Term"
@rhs0sym2 grammarCategory
    name "Copula"
@rhs0sym3 grammarCategory
    name "verbIng"
@rhs0sym4 grammarCategory
    name "Term"
@rhs0 list
    item1 $rhs0sym1
    item2 $rhs0sym2
    item3 $rhs0sym3
    item4 $rhs0sym4
@r0 addGrammarRule
    name "AtomV5Progressive"
    lhs "Atom"
    rhs $rhs0
    weight 5
@rhs1sym1 grammarCategory
    name "Term"
@rhs1sym2 grammarToken
    value "has"
@rhs1sym3 grammarCategory
    name "verbPart"
@rhs1sym4 grammarCategory
    name "Term"
@rhs1 list
    item1 $rhs1sym1
    item2 $rhs1sym2
    item3 $rhs1sym3
    item4 $rhs1sym4
@r1 addGrammarRule
    name "AtomV5Perfect"
    lhs "Atom"
    rhs $rhs1
    weight 5
@rhs2sym1 grammarCategory
    name "Term"
@rhs2sym2 grammarToken
