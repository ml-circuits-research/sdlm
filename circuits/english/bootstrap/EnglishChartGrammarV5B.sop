@rhs8 list
    item1 $rhs8sym1
    item2 $rhs8sym2
    item3 $rhs8sym3
    item4 $rhs8sym4
    item5 $rhs8sym5
@r8 addGrammarRule
    name "WhichV5NounProperty"
    lhs "Sentence"
