# V5 compositional grammar additions. Installed by a normal SOP bootstrap circuit.
@rhs0sym1 grammarToken
    value "is"
@rhs0 list
    item1 $rhs0sym1
@r0 addGrammarRule
    name "CopulaIs"
    lhs "Copula"
