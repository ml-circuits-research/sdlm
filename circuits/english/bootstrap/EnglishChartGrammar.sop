# Compositional CNL grammar installed by an ordinary SOP circuit.
@rhs0sym1 grammarCategory
    name "entity"
@rhs0 list
    item1 $rhs0sym1
@r0 addGrammarRule
    name "TermEntity"
    lhs "Term"
