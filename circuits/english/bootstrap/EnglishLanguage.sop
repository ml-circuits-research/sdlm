    class "verbBase"
    lemma "see"
@supports addLexeme
    surface "supports"
    class "verb3"
    lemma "support"
@support addLexeme
    surface "support"
    class "verbBase"
    lemma "support"
@requires addLexeme
    surface "requires"
    class "verb3"
    lemma "require"
@require addLexeme
    surface "require"
    class "verbBase"
    lemma "require"
@uses addLexeme
    surface "uses"
    class "verb3"
    lemma "use"
@use addLexeme
    surface "use"
    class "verbBase"
    lemma "use"
@studies addLexeme
    surface "studies"
    class "verb3"
    lemma "study"
@study addLexeme
    surface "study"
    class "verbBase"
    lemma "study"
@writes addLexeme
    surface "writes"
    class "verb3"
    lemma "write"
@write addLexeme
    surface "write"
    class "verbBase"
    lemma "write"
@improves addLexeme
    surface "improves"
    class "verb3"
    lemma "improve"
@improve addLexeme
    surface "improve"
    class "verbBase"
    lemma "improve"
@reduces addLexeme
    surface "reduces"
    class "verb3"
    lemma "reduce"
@reduce addLexeme
