# English knowledge is data installed by an ordinary SOP circuit.
# The JS kernel does not contain these words or output templates.
@entityPattern addTokenPattern
    class "entity"
    pattern "^[A-Z][A-Za-z0-9_-]*$"
@variablePattern addTokenPattern
    class "variable"
    pattern "^[A-Z]$"
@wordPattern addTokenPattern
    class "word"
    pattern "^[a-z][A-Za-z0-9_-]*$"
@numberPattern addTokenPattern
    class "number"
    pattern "^[+-]?[0-9]+([.][0-9]+)?$"

@a addLexeme
    surface "a"
    class "article"
    lemma "a"
@an addLexeme
    surface "an"
    class "article"
    lemma "an"

@likes addLexeme
    surface "likes"
    class "verb3"
    lemma "like"
@like addLexeme
    surface "like"
    class "verbBase"
    lemma "like"
@trusts addLexeme
    surface "trusts"
    class "verb3"
    lemma "trust"
@trust addLexeme
    surface "trust"
    class "verbBase"
    lemma "trust"
@helps addLexeme
    surface "helps"
    class "verb3"
    lemma "help"
@help addLexeme
    surface "help"
    class "verbBase"
    lemma "help"
@knows addLexeme
    surface "knows"
    class "verb3"
    lemma "know"
@know addLexeme
    surface "know"
    class "verbBase"
    lemma "know"
@sees addLexeme
    surface "sees"
    class "verb3"
    lemma "see"
@see addLexeme
