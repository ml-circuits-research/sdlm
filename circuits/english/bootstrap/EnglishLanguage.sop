@parent addLexeme
    surface "parent"
    class "relationNoun"
    lemma "parent"
@ancestor addLexeme
    surface "ancestor"
    class "relationNoun"
    lemma "ancestor"
@friend addLexeme
    surface "friend"
    class "relationNoun"
