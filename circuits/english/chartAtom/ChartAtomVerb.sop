@input tree
@g valueFieldIs
    value $tree
    name "production"
    expected "AtomVerb"
@s chartChild
    tree $tree
    index 0
@v chartChild
    tree $tree
    index 1
@o chartChild
    tree $tree
    index 2
@subject chartTerm
    tree $s
@predicate chartLemma
    tree $v
    class "verb3"
@object chartTerm
    tree $o
@atom makeBinaryAtom
    subject $subject
    predicate $predicate
    object $object
    polarity "positive"
@output result $atom
