@input tree
@g valueFieldIs
    value $tree
    name "production"
    expected "AtomUnaryNegativeArticle"
@s chartChild
    tree $tree
    index 0
@p chartChild
    tree $tree
    index 4
@subject chartTerm
    tree $s
@predicate chartNorm
    tree $p
@atom makeUnaryAtom
    subject $subject
    predicate $predicate
    polarity "negative"
@output result $atom
