@input tree
@g valueFieldIs
    value $tree
    name "production"
    expected "AtomVerbNegative"
@s chartChild
    tree $tree
    index 0
@v chartChild
    tree $tree
    index 3
@o chartChild
    tree $tree
    index 4
@subject chartTerm
    tree $s
@predicate chartLemma
    tree $v
    class "verbBase"
@object chartTerm
    tree $o
@atom makeBinaryAtom
    subject $subject
    predicate $predicate
    object $object
    polarity "negative"
@output result $atom
