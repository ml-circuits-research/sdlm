@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 6
@g1 tokenIs
    tokens $tokens
    index 0
    value "please"
@g2 tokenIs
    tokens $tokens
    index 1
    value "brief"
@g3 tokenIs
    tokens $tokens
    index 2
    value "me"
@g4 tokenIs
    tokens $tokens
    index 3
