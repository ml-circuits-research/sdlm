@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 5
@g1 tokenIs
    tokens $tokens
    index 1
    value "is"
@g2 tokenIs
    tokens $tokens
    index 2
    value "a"
@g3 tokenIs
    tokens $tokens
    index 3
    value "measurable"
@g4 tokenIs
    tokens $tokens
    index 4
    value "."
@g5 tokenClassIs
    tokens $tokens
