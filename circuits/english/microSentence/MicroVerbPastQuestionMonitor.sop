@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 5
@g1 tokenIs
    tokens $tokens
    index 0
    value "did"
@g2 tokenIs
    tokens $tokens
    index 2
    value "monitor"
@g3 tokenIs
    tokens $tokens
    index 4
    value "?"
@g4 tokenClassIs
    tokens $tokens
