@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 5
@g1 tokenIs
    tokens $tokens
    index 0
    value "could"
@g2 tokenIs
    tokens $tokens
    index 1
    value "you"
@g3 tokenIs
    tokens $tokens
    index 2
    value "explain"
@g4 tokenIs
    tokens $tokens
    index 4
    value "."
@g5 tokenClassIs
    tokens $tokens
    index 3
    class "entity"
@bias candidateWeight
    weight 22
@result MicroExpandEntity
    tokens $tokens
    entityIndex 3
@output result $result
