@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 6
@g1 tokenIs
    tokens $tokens
    index 0
    value "who"
@g2 tokenIs
    tokens $tokens
    index 1
    value "does"
@g3 tokenIs
    tokens $tokens
    index 3
    value "answer"
@g4 tokenIs
    tokens $tokens
    index 5
    value "?"
@g5 tokenClassIs
    tokens $tokens
    index 2
    class "entity"
@bias candidateWeight
    weight 29
@result MicroBinaryWhoObject
    tokens $tokens
    predicate "answer"
    subjectIndex 2
@output result $result
