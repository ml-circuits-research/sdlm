@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 4
@g1 tokenIs
    tokens $tokens
    index 0
    value "please"
@g2 tokenIs
    tokens $tokens
    index 1
    value "describe"
@g3 tokenIs
    tokens $tokens
    index 3
    value "."
@g4 tokenClassIs
    tokens $tokens
    index 2
    class "entity"
@bias candidateWeight
    weight 22
@result MicroDescribeEntity
    tokens $tokens
    entityIndex 2
@output result $result
