@input tokens
@g0 tokenCountIs
    tokens $tokens
    count 5
@g1 tokenIs
    tokens $tokens
    index 1
    value "is"
@g2 tokenIs
    tokens $tokens
    index 2
    value "not"
@g3 tokenIs
    tokens $tokens
