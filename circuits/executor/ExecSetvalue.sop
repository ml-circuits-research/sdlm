@input command
@guard commandKindIs
    value $command
    kind "setValue"
@payload field
    value $command
    name "payload"
@subject field
    value $payload
    name "subject"
@predicate field
    value $payload
    name "predicate"
@value field
    value $payload
    name "value"
@result kbSetValue
    subject $subject
    predicate $predicate
    value $value
@output result $result
