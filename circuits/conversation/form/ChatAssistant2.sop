@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 4
@n2 tokenIs
    tokens $tokens
    index 0
    value "what"
@n3 tokenIs
    tokens $tokens
    index 1
    value "is"
@n4 tokenIs
    tokens $tokens
    index 2
    value "your"
@n5 tokenIs
    tokens $tokens
    index 3
    value "name"
@n6 record
    kind "chat"
    message "I am sdlm, a symbolic language model. I use facts, rules and circuits to answer questions. Ask \"What can you do?\" for things to try."
@n7 makeCommand
    kind "chat"
    payload $n6
@n8 list
@n9 record
    command $n7
    decisions $n8
@output result $n9
