@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 3
@n2 tokenIs
    tokens $tokens
    index 0
    value "where"
@n3 tokenIs
    tokens $tokens
    index 1
    value "am"
@n4 tokenIs
    tokens $tokens
    index 2
    value "i"
@n5 ChatCurrentSpeaker
@n6 field
    value $n5
    name "value"
@n7 field
    value $n5
    name "atom"
@n8 record
    category "speaker-reference"
    original "i"
    value $n6
    reason "Resolved the first-person reference to the current speaker introduced in this session."
    certainty "contextual"
    evidence $n7
@n9 concat
    part1 "Where is "
    part2 $n6
    part3 "?"
@n10 list
    item0 $n8
@n11 list
    item0 $n7
@n12 record
    rewrite $n9
    decisions $n10
    evidence_atoms $n11
    exclusive true
    policy "ChatPersonalLookup2"
@output result $n12
