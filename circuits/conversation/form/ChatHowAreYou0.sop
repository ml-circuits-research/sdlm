@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 3
@n2 tokenIs
    tokens $tokens
    index 0
    value "how"
@n3 tokenIs
    tokens $tokens
    index 1
    value "are"
@n4 tokenIs
    tokens $tokens
    index 2
    value "you"
@n5 record
    kind "chat"
    message "I am ready to help. What would you like to work out?"
@n6 makeCommand
    kind "chat"
    payload $n5
@n7 list
@n8 record
    command $n6
    decisions $n7
@output result $n8
