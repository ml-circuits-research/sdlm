@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 4
@n2 tokenIs
    tokens $tokens
    index 0
    value "tell"
@n3 tokenIs
    tokens $tokens
    index 1
    value "me"
@n4 tokenIs
    tokens $tokens
    index 2
    value "about"
@n5 tokenIs
    tokens $tokens
    index 3
    value "me"
@n6 candidateWeight
    weight -10
@n7 record
    kind "chat"
    message "What name should I use? You can say \"My name is Jhon.\"."
@n8 makeCommand
    kind "chat"
    payload $n7
@n9 list
@n10 record
    command $n8
    decisions $n9
@output result $n10
