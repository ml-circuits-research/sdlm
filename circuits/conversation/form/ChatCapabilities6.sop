@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 5
@n2 tokenIs
    tokens $tokens
    index 0
    value "what"
@n3 tokenIs
    tokens $tokens
    index 1
    value "can"
@n4 tokenIs
    tokens $tokens
    index 2
    value "i"
@n5 tokenIs
    tokens $tokens
    index 3
    value "ask"
@n6 tokenIs
    tokens $tokens
    index 4
    value "you"
@capabilitiesText ChatCapabilitiesMessage
@n7 record
    kind "chat"
    message $capabilitiesText
@n8 makeCommand
    kind "chat"
    payload $n7
@n9 list
@n10 record
    command $n8
    decisions $n9
@output result $n10
