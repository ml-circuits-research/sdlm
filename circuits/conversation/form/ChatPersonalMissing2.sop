@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 3
@n2 tokenIs
    tokens $tokens
    index 0
    value "where"
@n3 tokenIs
    tokens $tokens
    index 1
    value "am"
@n4 tokenIs
    tokens $tokens
    index 2
    value "i"
@n5 candidateWeight
    weight -10
@n6 record
    kind "chat"
    message "What name should I use? You can say \"My name is Jhon.\"."
@n7 makeCommand
    kind "chat"
    payload $n6
@n8 list
@n9 record
    command $n7
    decisions $n8
@output result $n9
