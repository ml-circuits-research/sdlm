@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 5
@n2 tokenIs
    tokens $tokens
    index 0
    value "do"
@n3 tokenIs
    tokens $tokens
    index 1
    value "you"
@n4 tokenIs
    tokens $tokens
    index 2
    value "know"
@n5 tokenIs
    tokens $tokens
