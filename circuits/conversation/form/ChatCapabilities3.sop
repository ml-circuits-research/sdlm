@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 6
@n2 tokenIs
    tokens $tokens
    index 0
    value "what"
@n3 tokenIs
    tokens $tokens
    index 1
    value "you"
@n4 tokenIs
    tokens $tokens
    index 2
    value "can"
@n5 tokenIs
    tokens $tokens
    index 3
    value "do"
@n6 tokenIs
    tokens $tokens
    index 4
    value "for"
@n7 tokenIs
    tokens $tokens
    index 5
    value "me"
@capabilitiesText ChatCapabilitiesMessage
@n8 record
    kind "chat"
    message $capabilitiesText
@n9 makeCommand
    kind "chat"
    payload $n8
@n10 list
@n11 record
    command $n9
    decisions $n10
@output result $n11
