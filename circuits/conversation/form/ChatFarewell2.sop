@input tokens
@n1 tokenCountIs
    tokens $tokens
    count 2
@n2 tokenIs
    tokens $tokens
    index 0
    value "see"
@n3 tokenIs
    tokens $tokens
    index 1
    value "you"
@n4 record
    kind "chat"
    message "Goodbye! We can continue here later."
@n5 makeCommand
    kind "chat"
    payload $n4
@n6 list
@n7 record
    command $n5
    decisions $n6
@output result $n7
