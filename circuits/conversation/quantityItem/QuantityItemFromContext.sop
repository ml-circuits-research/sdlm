@input slots
@input owner
@n1 field
    value $slots
    name "predicate"
@n2 valueIs
    value $n1
    expected null
@n3 field
    value $owner
    name "subject"
@n4 record
    subject $n3
@n5 ReadQuantityContexts
    match $n4
@n6 hasItems
    values $n5
@n7 field
    value $n5
    name "0"
@n8 field
    value $n7
    name "predicate"
@n9 field
    value $n7
    name "atom"
@n10 record
    selected $n7
    alternatives $n5
    selectedBy "most-recent-item-for-owner"
@n11 sliceText
    value $n8
    start 6
@n12 record
    category "omitted-item"
    original "unspecified item"
    value $n11
    reason "Filled the omitted item from the most recently mentioned live quantity for the selected owner."
    certainty "contextual"
    evidence $n10
@n13 list
    item0 $n12
@n14 list
    item0 $n9
@n15 record
    predicate $n8
    decisions $n13
    evidence_atoms $n14
@output result $n15
