@input tokens
@n1 tokenCountAtLeast
    tokens $tokens
    count 6
@n2 record
    surface "the"
    value "the"
@n3 list
    item0 $n2
@n4 matchTokenChoice
    tokens $tokens
    index 0
    choices $n3
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n5 record
    surface "sum"
    value "sum"
@n6 list
    item0 $n5
@n7 matchTokenChoice
    tokens $tokens
    index 1
    choices $n6
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n8 record
    surface "of"
    value "of"
@n9 list
    item0 $n8
@n10 matchTokenChoice
    tokens $tokens
    index 2
    choices $n9
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n11 tokenCount
    tokens $tokens
@n12 sliceTokens
    tokens $tokens
    start 3
    end $n11
@n13 ChatMathNumber
    tokens $n12
@n14 field
    value $n13
    name "rest"
@n15 record
    surface "and"
    value "and"
@n16 list
    item0 $n15
@n17 matchTokenChoice
    tokens $n14
    index 0
    choices $n16
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n18 tokenCount
    tokens $n14
@n19 sliceTokens
    tokens $n14
    start 1
    end $n18
@n20 ChatMathNumber
    tokens $n19
@n21 field
    value $n20
    name "rest"
@n22 tokenCountIs
    tokens $n21
    count 0
@n23 field
    value $n13
    name "value"
@n24 field
    value $n20
    name "value"
@n25 record
    left $n23
    right $n24
    operation "add"
@n26 makeCommand
    kind "calculateNumber"
    payload $n25
@n27 collectDecisions
    part0 $n4
    part1 $n7
    part2 $n10
    part3 $n17
@n28 record
