@input tokens
@n1 tokenCountAtLeast
    tokens $tokens
    count 5
@n2 record
    surface "sum"
    value "sum"
@n3 list
    item0 $n2
@n4 matchTokenChoice
    tokens $tokens
    index 0
    choices $n3
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n5 record
    surface "of"
    value "of"
@n6 list
    item0 $n5
@n7 matchTokenChoice
    tokens $tokens
    index 1
    choices $n6
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n8 tokenCount
    tokens $tokens
@n9 sliceTokens
    tokens $tokens
    start 2
    end $n8
@n10 ChatMathNumber
    tokens $n9
@n11 field
    value $n10
    name "rest"
@n12 record
    surface "and"
    value "and"
@n13 list
    item0 $n12
@n14 matchTokenChoice
    tokens $n11
    index 0
    choices $n13
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n15 tokenCount
    tokens $n11
@n16 sliceTokens
    tokens $n11
    start 1
    end $n15
@n17 ChatMathNumber
    tokens $n16
@n18 field
    value $n17
    name "rest"
@n19 tokenCountIs
    tokens $n18
    count 0
@n20 field
    value $n10
    name "value"
@n21 field
    value $n17
    name "value"
@n22 record
    left $n20
    right $n21
    operation "add"
@n23 makeCommand
    kind "calculateNumber"
    payload $n22
@n24 collectDecisions
    part0 $n4
    part1 $n7
    part2 $n14
@n25 record
    command $n23
    decisions $n24
@output result $n25
