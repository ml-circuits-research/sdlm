@input tokens
@n1 tokenCountAtLeast
    tokens $tokens
    count 6
@n2 record
    surface "the"
    value "the"
@n3 list
    item0 $n2
@n4 matchTokenChoice
    tokens $tokens
    index 0
    choices $n3
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n5 record
    surface "result"
    value "result"
@n6 list
    item0 $n5
@n7 matchTokenChoice
    tokens $tokens
    index 1
    choices $n6
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n8 record
    surface "of"
    value "of"
@n9 list
    item0 $n8
@n10 matchTokenChoice
    tokens $tokens
    index 2
    choices $n9
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n11 tokenCount
    tokens $tokens
@n12 sliceTokens
    tokens $tokens
    start 3
    end $n11
@n13 ChatMathRequest
    tokens $n12
@n14 collectDecisions
    part0 $n4
    part1 $n7
    part2 $n10
    part3 $n13
@n15 setField
    value $n13
    name "decisions"
    fieldValue $n14
@output result $n15
