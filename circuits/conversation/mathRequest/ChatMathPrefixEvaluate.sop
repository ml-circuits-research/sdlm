@input tokens
@n1 tokenCountAtLeast
    tokens $tokens
    count 4
@n2 record
    surface "evaluate"
    value "evaluate"
@n3 list
    item0 $n2
@n4 matchTokenChoice
    tokens $tokens
    index 0
    choices $n3
    maxDistance 1
    minLength 3
    maxLength 32
    category "lexical-repair"
    reason "Used the unique nearest spelling allowed in this arithmetic position. The complete request matched two numeric operands and an operation; the numbers were not changed."
@n5 tokenCount
    tokens $tokens
@n6 sliceTokens
    tokens $tokens
    start 1
    end $n5
@n7 ChatMathRequest
    tokens $n6
@n8 collectDecisions
    part0 $n4
    part1 $n7
@n9 setField
    value $n7
    name "decisions"
    fieldValue $n8
@output result $n9
