@input tokens
@n1 tokenCountAtLeast
    tokens $tokens
    count 3
@n2 record
    surface "loses"
    value "loses"
@n3 record
    surface "lose"
    value "lose"
@n4 record
    surface "lost"
    value "lost"
@n5 record
    surface "eats"
    value "eats"
@n6 record
    surface "eat"
    value "eat"
@n7 record
    surface "ate"
    value "ate"
@n8 record
    surface "uses"
    value "uses"
@n9 record
    surface "use"
    value "use"
@n10 record
    surface "used"
    value "used"
@n11 record
    surface "spends"
    value "spends"
@n12 record
    surface "spend"
    value "spend"
@n13 record
    surface "spent"
    value "spent"
@n14 record
    surface "sells"
    value "sells"
@n15 record
    surface "sell"
    value "sell"
@n16 record
    surface "sold"
    value "sold"
@n17 record
    surface "gives"
    value "gives"
@n18 record
    surface "give"
    value "give"
@n19 record
    surface "gave"
    value "gave"
@n20 list
    item0 $n2
    item1 $n3
    item2 $n4
    item3 $n5
    item4 $n6
    item5 $n7
    item6 $n8
    item7 $n9
    item8 $n10
    item9 $n11
    item10 $n12
    item11 $n13
    item12 $n14
    item13 $n15
    item14 $n16
    item15 $n17
    item16 $n18
    item17 $n19
@n21 matchTokenChoice
    tokens $tokens
    index 1
    choices $n20
@n22 field
    value $n21
    name "value"
@n23 numericToken
    tokens $tokens
    index 2
@n26 tokenCount
    tokens $tokens
@n27 sliceTokens
    tokens $tokens
    start 3
    end $n26
@n28 list
    item0 "now"
@n29 list
    item0 "more"
@n30 trimTokenEdges
    tokens $n27
    trailing $n28
    leading $n29
@n31 ParseQuantityItem
    tokens $n30
@n32 calculateNumber
    left $n23
    right -1
    operation "multiply"
@n33 field
    value $n32
    name "value"
@n34 sliceTokens
    tokens $tokens
    start 0
    end 1
@n35 field
    value $n31
    name "predicate"
@n36 field
    value $n31
    name "decisions"
@n37 record
    kind "adjustNumber"
    ownerTokens $n34
    predicate $n35
    amount $n33
    decisions $n36
@output result $n37
